# Next.js 서버에서만 사용 (NEXT_PUBLIC_ 붙이지 않음)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 출시 전환 플래그. 기본은 신청 폼(waitlist). 출시일에 released로 바꾸고
# DOWNLOAD_URL을 실제 다운로드 링크로 채운 뒤 재배포해요.
RELEASE_STAGE=waitlist
DOWNLOAD_URL=

# 메일 발송 비밀값은 여기가 아니라 `supabase secrets set` 으로 설정해요.
# RESEND_API_KEY, ADMIN_SECRET, MAIL_FROM, SITE_URL
